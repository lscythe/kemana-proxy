amends "package://github.com/jdx/hk/releases/download/v2.9.0/hk@2.9.0#/Config.pkl"

local linters = new Mapping<String, Step> {
    ["rustfmt"] {
        glob = List("**/*.rs")
        fix = "cargo fmt"
        check = "cargo fmt --check"
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["check"] {
        steps = linters
    }
    ["commit-msg"] {
        steps = new Mapping<String, Step> {
            ["check-commit-scope"] {
                check = "python3 .github/scripts/commit_scope.py {{commit_msg_file}}"
            }
        }
    }
    ["pre-push"] {
        steps = new Mapping<String, Step> {
            ["check-and-test"] {
                check = "mise run check && mise run test"
            }
        }
    }
}
